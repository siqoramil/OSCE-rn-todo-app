# Firebase web app config — copy this file to ".env" and fill in the values from
# Firebase Console → Project settings → General → Your apps → SDK setup and configuration.
# EXPO_PUBLIC_ vars are inlined into the JS bundle by Expo, so only use the WEB config
# (these keys are not secrets; access is controlled by Firestore security rules).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In OAuth client IDs.
# Enable Firebase Console → Authentication → Sign-in method → Google first; that
# creates the OAuth clients for you in Google Cloud Console → APIs & Services →
# Credentials (same project as Firebase).
#
# WEB client ID is required on every platform — Firebase validates the ID token
# against it. It looks like "1234567890-abc....apps.googleusercontent.com".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID is only needed when running on iOS. Create an "iOS" OAuth client
# with bundle ID com.oscetodo.app if one doesn't exist yet.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android needs no client ID in the app, but you MUST register an "Android"
# OAuth client with package com.oscetodo.app and your keystore's SHA-1
# fingerprint, otherwise sign-in fails with DEVELOPER_ERROR.
